FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt cryptography pip-audit
COPY gates/ gates/
COPY fortress/ fortress/
COPY services/ services/
COPY scripts/ scripts/
COPY requirements.txt requirements-gates.txt ./
ENV PYTHONPATH=/app
ENTRYPOINT ["bash", "scripts/ci/gate_code.sh"]
